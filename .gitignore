# Go binaries and object files
bin/
# NOTE (2026-07-13): do not re-add a blanket pkg/ rule -- this project keeps real first-party source under pkg/ (codeintel, filters, interfaces, types, verifiers) wired into config/core/providers/tools/main.go. A prior fix for this was reverted by a concurrent commit from another automated agent (8a21f2fd5); re-applying.
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage
*.test
*.out
coverage.txt

# Temporary and logs
tmp/
logs/
*.log

# JIT-generated tool scripts (runtime artifacts written by the JIT sandbox
# mechanism per-task, e.g. jit_tools/jit_08cf755c.lua -- not source code,
# should not be committed; confirmed 2026-07-17 by reading actual content).
jit_tools/

# Bun cache (runtime dependency cache)
bridge/.bun/cache/
  
# Per-task runtime output/manifest artifacts (2026-08-10)  
outputs/  
tasks/  
_test_pid.xml  
scripts/launch/safe_build.txt  

# SQLite runtime DB (created by store.InitDB at startup, pure runtime state)
orchestrator_runtime.db
orchestrator_runtime.db-shm
orchestrator_runtime.db-wal

# Temporary recovery/staging files (2026-09-08)
orchestrator_go.new
orchestrator_go.prev

# Trash staging directory (2026-09-20) — files quarantined before deletion.
# Review after a few days of clean operation, then delete for real.
trash/

# Backup directories (2026-10-12) — stale Go snapshots with //go:build ignore tags.
# Must be gitignored so they don't pollute the module or break CI tooling.
backups/
/.idea/*
# Git-tracked binary bloat (untracked 2026-09-20) — 22MB compiled binary
# and large schema diff text file should not be in version control.
orchestrator_mcp
schemas/fc_diff.txt
# Cookbook sync cache (content-addressed .ptr/.txt files fetched at runtime
# from GitHub cookbook sources via FetchCookbook — may contain vendor-
# copyrighted prompt text from leaked/system-prompt repos; must never be
# committed, especially for open-core release)
store/cookbooks/

# Runtime artifacts
data/          # CaSKG causal_skill_graph.json + runtime outputs (spawner.go NewCaSKGManager)
nul
orchestrator-linux-amd64
core/data/
core/task_human_1/
pkg/api/data/
_a.py
_b.py
