# Vortex — Environment Variables
# Copy to .env and fill in your values. Never commit .env (it's gitignored).

# ── Transport ───────────────────────────────────────────
VORTEX_TRANSPORT=stdio          # stdio | sse
VORTEX_HOST=0.0.0.0             # SSE bind host
VORTEX_PORT=8000                # SSE bind port
VORTEX_BASE_URL=                # SSE base URL for generated links (optional)

# ── Paths ───────────────────────────────────────────────
VORTEX_CONFIG=config.json       # config file path
VORTEX_DB_PATH=vortex.db        # SQLite database path

# ── AI Provider Keys ────────────────────────────────────
# Set only the keys for providers you use. Ollama needs no key (set base_url in config.json).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_TOKEN=

# ── Feature Flags ───────────────────────────────────────
VORTEX_DEBUG=false              # enable debug logging (true|false)
VORTEX_DELEGATION_MODE=         # override delegation mode at startup
VORTEX_WAL_ENABLED=false        # write-ahead log for crash recovery
VORTEX_REPLAY_ENABLED=false     # replay events on startup

# ── Security ────────────────────────────────────────────
VORTEX_ALLOW_DEPLOY_WRITE=      # allow deploy tool to write (security gate)
VORTEX_PUBLIC_KEY=              # public key for signature verification

# ── Advanced (usually unset) ────────────────────────────
VORTEX_CONFIG_NO_OCC=           # disable optimistic concurrency control (1)
VORTEX_CONFIG_SPLIT_THRESHOLD= # config auto-split threshold (e.g. 500)
VORTEX_CONFIG_NO_AUTOSPLIT=    # disable config auto-split (1)
VORTEX_SPAN_ID=                 # tracing span ID (distributed tracing)
VORTEX_TRACE_ID=                # tracing trace ID (distributed tracing)
